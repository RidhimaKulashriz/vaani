# Local application ports and services
PORT=3000
API_PORT=4001
API_ORIGIN=http://127.0.0.1:4001
APP_DATABASE_URL=
REDIS_URL=
DATA_DIR=./data
PUBLIC_APP_ORIGIN=

# Manus app OAuth/session settings; keep empty until the project is configured.
MANUS_PROJECT_ID=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=
MANUS_JWT_SECRET=

# Preview is HTTPS inside a cross-site iframe; retain these values there.
# For plain-HTTP localhost only, use an untracked .env.local override:
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=none

# Real telephony and vendor services are deliberately off.
EXTERNAL_CALLS_ENABLED=false
TELEPHONY_PROVIDER=mock
STT_PROVIDER=mock
PLANNER_PROVIDER=mock
TTS_PROVIDER=mock
RECORDING_ENABLED=false

# Optional live integrations. Leave blank in mock mode.
GNANI_API_KEY_ID=
GNANI_API_KEY_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
SENTRY_DSN=

# Local Compose services only; replace the placeholders before exposing anything.
POSTGRES_PASSWORD=local-only-change-me
MINIO_ROOT_USER=vaani-local
MINIO_ROOT_PASSWORD=local-minio-change-me
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-grafana-change-me
