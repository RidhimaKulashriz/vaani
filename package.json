{
  "name": "vaani-dalal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"pnpm --filter @vaani/api dev\" \"pnpm --filter @vaani/web dev\"",
    "start": "concurrently -k -n API,WEB \"pnpm --filter @vaani/api start\" \"pnpm --filter @vaani/web start\"",
    "build": "pnpm typecheck && pnpm --filter @vaani/web build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "simulate:100": "tsx scripts/simulate-100.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm simulate:100 && pnpm build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.7",
    "eslint": "10.14.0",
    "tsx": "4.23.15",
    "typescript-eslint": "8.72.2",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
