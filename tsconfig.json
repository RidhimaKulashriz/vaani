{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@vaani/protocol": ["packages/protocol/src/index.ts"],
      "@vaani/audio": ["packages/audio/src/index.ts"],
      "@vaani/adapters": ["packages/adapters/src/index.ts"],
      "@vaani/orchestrator": ["packages/orchestrator/src/index.ts"],
      "@vaani/storage": ["packages/storage/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "app.config.ts",
    "apps/web/next-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/.next",
    "**/dist",
    "coverage",
    "playwright-report",
    "test-results"
  ]
}
